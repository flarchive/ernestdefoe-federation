{
  "name": "ernestdefoe/federation",
  "description": "ActivityPub federation for Flarum 2 — make your community a discoverable, followable fediverse actor. People on Mastodon, Lemmy and other servers can follow @{community}@{host} (and individual members) and receive every new discussion in their timeline. Inbound replies and likes flow back in as posts and reactions. No core files touched.",
  "keywords": ["flarum", "flarum-extension", "activitypub", "fediverse", "mastodon", "federation", "webfinger"],
  "type": "flarum-extension",
  "license": "MIT",
  "authors": [
    {
      "name": "ernestdefoe",
      "email": "ernestdefoe@gmail.com"
    }
  ],
  "homepage": "https://github.com/ernestdefoe/federation",
  "support": {
    "forum": "https://discuss.flarum.org/d/39465-federation-made-with-ai",
    "issues": "https://github.com/ernestdefoe/federation/issues",
    "source": "https://github.com/ernestdefoe/federation"
  },
  "require": {
    "php": "^8.3",
    "ext-openssl": "*",
    "flarum/core": "^2.0",
    "guzzlehttp/guzzle": "^7.0"
  },
  "autoload": {
    "psr-4": {
      "ErnestDefoe\\Federation\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "ErnestDefoe\\Federation\\Tests\\": "tests/"
    }
  },
  "extra": {
    "flarum-extension": {
      "title": "Federation (ActivityPub)",
      "optional-dependencies": [
        "flarum/approval",
        "flarum/tags"
      ],
      "category": "feature",
      "icon": {
        "name": "fas fa-globe",
        "backgroundColor": "#5b3df5",
        "color": "#fff"
      }
    },
    "flarum-cli": {
      "modules": {
        "js": true,
        "css": false,
        "locale": true
      }
    }
  },
  "require-dev": {
    "flarum/approval": "^2.0",
    "flarum/phpstan": "^2.0",
    "flarum/testing": "^2.0"
  },
  "scripts": {
    "test": [
      "@test:integration"
    ],
    "test:integration": "phpunit -c tests/phpunit.integration.xml",
    "test:setup": "@php tests/integration/setup.php",
    "analyse:phpstan": "phpstan analyse"
  },
  "scripts-descriptions": {
    "test": "Runs all tests.",
    "test:integration": "Runs all integration tests.",
    "test:setup": "Sets up a database for use with integration tests. Execute this only once.",
    "analyse:phpstan": "Run static analysis"
  },
  "minimum-stability": "beta",
  "prefer-stable": true
}
